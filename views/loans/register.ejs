<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Loan | Inuuka Loan Tracker</title>
</head>
<body>

    <h1>Register New Loan</h1>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <% if (success) { %>
        <p style="color: green;"><%= success %></p>
    <% } %>

    <% if (clients.length === 0) { %>

        <p>No clients have been registered yet.</p>
        <a href="/clients/register">Register a client first</a>

    <% } else { %>

        <form action="/loans/register" method="POST">

            <div>
                <label for="loanReference">Loan Reference</label>

                <input
                    type="text"
                    id="loanReference"
                    name="loanReference"
                    value="<%= formData.loanReference || '' %>"
                    required
                >
            </div>

            <div>
                <label for="clientId">Select Client</label>

                <select id="clientId" name="clientId" required>

                    <option value="">Choose a client</option>

                    <% clients.forEach(client => { %>

                        <option
                            value="<%= client.id %>"
                            <%= String(formData.clientId) === String(client.id) ? 'selected' : '' %>
                        >
                            <%= client.client_number %> -
                            <%= client.client_name %>
                        </option>

                    <% }) %>

                </select>
            </div>

            <div>
                <label for="loanAmount">Loan Amount (KES)</label>

                <input
                    type="number"
                    id="loanAmount"
                    name="loanAmount"
                    min="0.01"
                    step="0.01"
                    value="<%= formData.loanAmount || '' %>"
                    required
                >
            </div>

            <div>
                <label for="totalAmountDue">Total Amount Due (KES)</label>

                <input
                    type="number"
                    id="totalAmountDue"
                    name="totalAmountDue"
                    min="0.01"
                    step="0.01"
                    value="<%= formData.totalAmountDue || '' %>"
                    required
                >
            </div>

            <button type="submit">Register Loan</button>

        </form>

    <% } %>

</body>
</html>